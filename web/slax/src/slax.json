{
    "name": "skybb",
    "title": "skybb vertical portal system",
    "baseUrl" : "",
    "directories" : {
        "library" : "./lib",
        "dist" : "./dist"
    },

    "pages" : [
        {
            "name" : "client",
            "dir" : "./pages/client",
            "bundle" : {
                "include" : [
                    "slax-skybb-client/main"
                ],
                "concats" : {
                    "before" : [
                    ],
                    "after" : [
                    ]
                }
            }
        },
        {
            "name" : "admin",
            "dir" : "./pages/admin",
            "bundle" : {
                "include" : [
                    "slax-skybb-admin/main"
                ],
                "concats" : {
                    "before" : [
                    ],
                    "after" : [
                    ]
                }
            }
        }
    ],

    "services" : {
        "dir"  : "./services"
    },

    "scripts" : {
      "packages" :  {
        "slax-skybb-base" : "./scripts/slax-skybb-base",
        "slax-skybb-client" : "./scripts/slax-skybb-client",
        "slax-skybb-composer" : "./scripts/slax-skybb-composer",
        "slax-skybb-admin" : "./scripts/slax-skybb-admin",
        "utilhub-toolkits-comctrls-carousels" : "./scripts/utilhub-toolkits-comctrls-carousels",
        "utilhub-toolkits-comctrls-pickers" : "./scripts/utilhub-toolkits-comctrls-pickers",
        "utilhub-toolkits-oneplayer" : "./scripts/utilhub-toolkits-oneplayer"
      },
      "bundles" : {
          "admin" : {
              "include" : [
                  "slax-skybb-admin/main"
              ],
              "exclude" : [
                "skylark-slax-runtime"
              ],
              "concats" : {
                  "before" : [
                  ],
                  "after" : [
                  ]
              }
          },
          "client" : {
              "include" : [
                  "slax-skybb-client/main"
              ],
              "concats" : {
                  "before" : [
                  ],
                  "after" : [
                  ]
              }
          }
      }
    },


    "templates" : {
        "dir"  : "./templates"
    },

    "styles" : {
        "dir" : "./styles",
        "bundles" : {
          "admin" : {
            "paths" : [
              "./node_modules"
            ],

            "files" : [
              "@import  \"skylark-appify-shells/skins/bs3/fontawesome/less/font-awesome.less\";",
              "@import \"less/skybb-slax/admin/admin\";",
              "@import \"less/skybb-slax/generics.less\";",
              "@import (inline) \"skylark-jqueryui/themes/bs3/jquery-ui-1.10.3.custom.css\";",
              "@import (inline) \"skylark-appify-shells/skins/bs3/bootstrap-taginput/bootstrap-taginput.css\";",
              "@import (inline) \"skylark-appify-shells/skins/bs3/bootstrap-material-design/bootstrap-material-design.css\";",
              "@import (inline) \"skylark-eyecon-colorpicker/skins/default/colorpicker.css\";"            
            ]
          }            
        }
    },

    "languages" : {
       "dir"  : "./languages"

    },
    "resources" : {

    },

    "build" : {
      "scripts" : {
        "bundles" : {
          "base" : {
              "includes" : [
                "slax/packages/socket.io.js",
                "slax/packages/require.js",
                "slax/packages/require-config.js"
              ],
              "modules" : [
              ]
          },
          "client" : {
              "output" : {
                "dir" : "build/public",
                "file" : "client.min.js"
              },
              "includes" : [
                "slax/dist/scripts/slax-skybb-client.js",
                "slax/packages/client.init.js"
              ]
          },
          "admin" : {
              "output" : {
                "dir" : "build/public",
                "file" : "acp.min.js"
              },
              "includes" : [
                "slax/dist/scripts/slax-skybb-admin.js",
                "slax/packages/admin.init.js"
             ]

          }
        }

      },
      "styles" : {

      },
      "templates" : {
        "source" : "slax/src/templates",
        "output" : "build/public/templates"
      },
      "locales" : {
        "source" : "slax/src/languages",
        "output" : "build/public/language",
        "plugins" : [
        ]
      }

    }


}