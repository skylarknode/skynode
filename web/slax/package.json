{
  "name": "slax-skybb",
  "version": "0.9.0",
  "description": "The skydoku slax application.",
  "main": "./index",
  "scripts": {
    "build": "slax build ."
  },
  "homepage": "skybb.iwebterm.com",
  "keywords": [
    "skybb",
    "slax"
  ],
  "author": "liwenfeng",
  "dependencies": {
    "skylark-slax-runtime": "git+https://github.com/skylark-slax/skylark-slax-runtime.git",
    "skylark-appify-shells": "git+https://github.com/skylark-appify/skylark-appify-shells.git",
    "skylark-ace": "git+https://github.com/skylark-integration/skylark-ace.git",
    "skylark-benchpress": "git+https://github.com/skylark-integration/skylark-benchpress.git",
    "skylark-bootstrap3": "git+https://github.com/skylark-integration/skylark-bootstrap3.git",
    "skylark-chartjs": "git+https://github.com/skylark-integration/skylark-chartjs.git",
    "skylark-clipboard": "git+https://github.com/skylark-integration/skylark-clipboard.git",
    "skylark-codemirror": "git+https://github.com/skylark-integration/skylark-codemirror.git",
    "skylark-cropperjs": "git+https://github.com/skylark-integration/skylark-cropperjs.git",
    "skylark-datgui": "git+https://github.com/skylark-integration/skylark-datgui.git",
    "skylark-eyecon-colorpicker": "git+https://github.com/skylark-integration/skylark-eyecon-colorpicker.git",
    "skylark-jquery-form": "git+https://github.com/skylark-integration/skylark-jquery-form.git",
    "skylark-jquery-textcomplete": "git+https://github.com/skylark-integration/skylark-jquery-textcomplete.git",
    "skylark-jquery-timeago": "git+https://github.com/skylark-integration/skylark-jquery-timeago.git",
    "skylark-jqueryui": "git+https://github.com/skylark-integration/skylark-jqueryui.git",
    "skylark-jqueryui-interact": "git+https://github.com/skylark-integration/skylark-jqueryui-interact.git",
    "skylark-jszip": "git+https://github.com/skylark-integration/skylark-jszip.git",
    "skylark-mousetrap": "git+https://github.com/skylark-integration/skylark-mousetrap.git",
    "skylark-panolens": "git+https://github.com/skylark-integration/skylark-panolens.git",
    "skylark-videojs-vtt": "git+https://github.com/skylark-integration/skylark-videojs-vtt.git",
    "skylark-slideout": "git+https://github.com/skylark-integration/skylark-slideout.git",
    "skylark-sortable": "git+https://github.com/skylark-integration/skylark-sortable.git",
    "skylark-threejs": "git+https://github.com/skylark-integration/skylark-threejs.git",
    "skylark-threejs-ex": "git+https://github.com/skylark-integration/skylark-threejs-ex.git",
    "skylark-widgets-base": "git+https://github.com/skylark-widgets/skylark-widgets-base.git",
    "skylark-widgets-codeground": "git+https://github.com/skylark-widgets/skylark-widgets-codeground.git",
    "skylark-widgets-textpad": "git+https://github.com/skylark-widgets/skylark-widgets-textpad.git",
    "skylark-widgets-wordpad": "git+https://github.com/skylark-widgets/skylark-widgets-wordpad.git",
    "skylark-zxcvbn": "git+https://github.com/skylark-integration/skylark-zxcvbn.git"
  },
  "skylarkjs": {
    "type": "slax",
    "directories": {
      "dependencies": "./node_modules",
      "src": "./src",
      "obj": "./obj",
      "dist": "./dist"
    },
    "build2": {
      "prepare": {
        "texttojs": [
          "html",
          "json",
          "css"
        ],
        "jsxtojs": false,
        "es6toamd": false,
        "cjstoamd": false
      },
      "bundles": {
        "standard": {
          "include": [
            "translator",
            "utils"
          ]
        }
      }
    },
     "build" : {
      "scripts" : {
        "bundles" : {
          "base" : {
              "includes" : [
                "slax/packages/socket.io.js",
                "slax/packages/require.js",
                "slax/packages/require-config.js"
              ],
              "modules" : [
              ]
          },
          "client" : {
              "output" : {
                "dir" : "build/public",
                "file" : "client.min.js"
              },
              "includes" : [
                "slax/dist/scripts/slax-skybb-client.js",
                "slax/packages/client.init.js"
              ]
          },
          "admin" : {
              "output" : {
                "dir" : "build/public",
                "file" : "acp.min.js"
              },
              "includes" : [
                "slax/dist/scripts/slax-skybb-admin.js",
                "slax/packages/admin.init.js"
             ]

          }
        }

      },
      "styles" : {

      },
      "templates" : {
        "source" : "slax/src/templates",
        "output" : "build/public/templates"
      },
      "locales" : {
        "source" : "slax/src/languages",
        "output" : "build/public/language",
        "plugins" : [
        ]
      }

    } 
  },
  "engines": {
    "node": ">=0.8.0"
  }
}
